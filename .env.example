# ─────────────────────────────────────────────────
#  PW PCB Updates — Instagram Content Manager
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# App
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=false
PORT=5000

# ── YouTube Data API ──────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Telegram API ──────────────────────────────────
# Get from: https://my.telegram.org/apps
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION=pw_monitor

# PW Telegram channels to monitor (comma separated, no @)
PW_TELEGRAM_CHANNELS=physicswallah,pw_neet_pcb,neet_pw_official

# ── Twitter / X API ───────────────────────────────
# Get from: https://developer.twitter.com
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# PW Twitter accounts to monitor (comma separated, no @)
PW_TWITTER_ACCOUNTS=PhysicsWallah,AlakhPandey01

# ── Instagram ─────────────────────────────────────
# Use your Instagram business/creator account credentials
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ── Claude / Anthropic API ────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Scheduler ─────────────────────────────────────
# How often to collect updates (in hours)
COLLECTION_INTERVAL_HOURS=3

# ── Database ──────────────────────────────────────
DATABASE_URL=sqlite:///pw_pcb_updates.db
